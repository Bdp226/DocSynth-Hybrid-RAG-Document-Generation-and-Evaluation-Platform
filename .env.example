# Core
APP_ENV=dev
LOG_LEVEL=INFO

# Build provenance (injected by the container build; surfaced on GET /version)
GIT_COMMIT=unknown
BUILD_TIME=unknown

# API
HOST=0.0.0.0
PORT=8080

# LLM Endpoint (private only)
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.1:8b-instruct
VISION_MODEL=llama3.2-vision:11b
LLM_TIMEOUT_SECONDS=60

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector DB (self-hosted)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=doc_optimizer

# Security
ENABLE_POLICY_GUARDS=true
MAX_INPUT_CHARS=80000
ARTIFACT_STORAGE_DIR=/tmp/doc_optimizer_artifacts
ENFORCE_IDENTITY_HEADERS=true
ALLOWED_ROLES=author,reviewer,admin
RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=180
RAG_TOP_K_CHUNKS=8
RAG_USE_EMBEDDINGS=true

# Ingress protection (per replica). Set RPM to 0 to disable for load testing.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_EXEMPT_PATHS=/healthz,/readyz,/health,/version,/metrics
MAX_REQUEST_BYTES=25000000

# Cross-origin access (off by default; the UI is served same-origin)
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=

# Readiness: when true, /readyz reports 503 if the LLM endpoint is unreachable
READINESS_REQUIRES_LLM=false
